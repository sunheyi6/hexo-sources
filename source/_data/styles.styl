.text-center {
  text-align: center;
}

.site-author-image {
  background: white;
  background-clip: content-box;
}

.sidebar .sidebar-button {
  &:not(:last-child) {
    margin-bottom: 15px;
  }

  a {
    button($orange);
    border: 1px solid $orange;
    border-radius: 4px;
    // To make line-height in button mixin work
    display: inline-block;

    .fa, .fab, .far, .fas {
      margin-right: 5px;
    }

    if (($scheme == 'Pisces') or ($scheme == 'Gemini')) {
      border: 0;
      color: $orange;
      display: block;

      &:hover {
        background: none;
        border: 0;
        color: darken($orange, 20%);
      }
    }
  }
}

body {
  background: var(--body-bg-color, #f2efe9);
  font-size: 18px;
}

// 复刻 theme-switch.pages.dev 的 Sunny 效果
@property --bg    { syntax: '<color>'; inherits: true; initial-value: #f2efe9; }
@property --text  { syntax: '<color>'; inherits: true; initial-value: #1a1a1a; }
@property --mid   { syntax: '<color>'; inherits: true; initial-value: #888888; }
@property --line  { syntax: '<color>'; inherits: true; initial-value: #d8d5cf; }
@property --accent { syntax: '<color>'; inherits: true; initial-value: #8b7355; }

body.sunny {
  --bg: #f2efe9;
  --text: #1a1a1a;
  --mid: #888888;
  --line: #d8d5cf;
  --accent: #8b7355;
  background: var(--bg);
  transition: --bg 400ms ease, --text 400ms ease, --mid 400ms ease, --line 400ms ease, --accent 400ms ease;
}



//博客内容透明化
//文章内容的透明度设置
.content-wrap {
  opacity: 0.95;
}

//侧边框的透明度设置
.sidebar {
  opacity: 0.8;
}

//菜单栏的透明度设置
.header-inner {
  background: var(--content-bg-color);
}

//搜索框（local-search）的透明度设置
.popup {
  opacity: 0.8;
}

// ==================== Archives 页面样式优化 - 现代简洁风格 ====================

.posts-collapse {
  // 移除默认时间线
  .post-content::before {
    display: none;
  }

  // 统计标题 - 简洁风格
  .collection-title {
    text-align: center;
    margin-bottom: 60px;
    padding: 40px 0;
    border-bottom: 1px solid #eee;
    
    .collection-header {
      font-size: 14px;
      color: #999;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 400;
      
      &::before {
        display: none;
      }
    }
  }

  // 年份标题 - 大字号极简风格
  .collection-year {
    margin: 10px 0 5px 0;
    position: relative;
    text-align: center;
    
    &:first-of-type {
      margin-top: 5px;
    }
    
    .collection-header {
      font-size: 48px;
      font-weight: 200;
      color: #ddd;
      letter-spacing: 4px;
      display: inline-block;
      position: relative;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      
      // 底部装饰线
      &::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 1px;
        background: linear-gradient(to right, transparent, #ccc, transparent);
      }
    }
    
    &::before {
      display: none;
    }
  }

  // 文章列表 - 卡片式布局
  .post-item {
    margin-bottom: 0;
    position: relative;
  }

  // 文章头部 - 简洁列表风格
  .post-header {
    display: flex;
    align-items: baseline;
    padding: 20px 0;
    margin: 0;
    border-bottom: 1px solid #f5f5f5;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    
    // 悬停指示条
    &::before {
      content: '';
      position: absolute;
      left: -20px;
      top: 50%;
      transform: translateY(-50%) scaleY(0);
      width: 3px;
      height: 20px;
      background: #333;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 2px;
    }
    
    // 时间 - 左侧固定宽度
    time {
      font-size: 13px;
      color: #bbb;
      font-family: 'SF Mono', 'Monaco', 'Inconsolata', monospace;
      min-width: 100px;
      flex-shrink: 0;
      font-weight: 400;
      letter-spacing: 0.5px;
    }
    
    // 标题容器
    > .post-content {
      flex: 1;
      margin: 0;
      padding: 0 20px;
      
      .post-title-link {
        font-size: 16px;
        color: #444;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline;
        line-height: 1.6;
        font-weight: 400;
        
        &:hover {
          color: #000;
        }
        
        // 外部链接图标
        .fa-external-link-alt {
          font-size: 11px;
          margin-left: 8px;
          color: #ccc;
          transition: color 0.3s ease;
        }
      }
    }
    
    // 悬停效果
    &:hover {
      background: transparent;
      border-bottom-color: #eee;
      
      &::before {
        transform: translateY(-50%) scaleY(1);
      }
      
      time {
        color: #666;
      }
      
      .post-title-link {
        color: #000;
        
        .fa-external-link-alt {
          color: #999;
        }
      }
    }
  }
}

// 响应式优化
@media (max-width: 767px) {
  .posts-collapse {
    .collection-title {
      margin-bottom: 40px;
      padding: 30px 0;
      
      .collection-header {
        font-size: 12px;
      }
    }
    
    .collection-year {
      margin: 50px 0 30px 0;
      
      .collection-header {
        font-size: 36px;
      }
    }
    
    .post-header {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px 0;
      
      &::before {
        left: -15px;
        width: 2px;
        height: 16px;
      }
      
      time {
        font-size: 12px;
        margin-bottom: 6px;
        color: #555;
      }
      
      > .post-content {
        padding: 0;
        
        .post-title-link {
          font-size: 15px;
        }
      }
    }
  }
}

/* ==================== Projects Page ==================== */
.project-showcase {
  --project-accent: #f97316;
  --project-text: #1e293b;
  --project-muted: #64748b;
  margin: 12px 0 24px;
}

.project-showcase-header {
  margin-bottom: 20px;
  padding: 18px 20px;
  border-radius: 14px;
  background: linear-gradient(140deg, rgba(248, 250, 252, 0.9), rgba(255, 247, 237, 0.95));
  border: 1px solid rgba(249, 115, 22, 0.22);

  h2 {
    margin: 0;
    color: var(--project-text);
    font-size: 24px;
    font-weight: 700;
  }

  p {
    margin: 8px 0 0;
    color: var(--project-muted);
    font-size: 14px;
    line-height: 1.7;
  }
}

.project-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.project-card {
  position: relative;
  padding: 18px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 252, 0.9));
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(249, 115, 22, 0.45);
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.12);
  }
}

.project-title {
  margin: 0;
  color: var(--project-text);
  font-size: 18px;
  line-height: 1.45;
}

.project-description {
  margin: 10px 0 14px;
  color: var(--project-muted);
  line-height: 1.75;
  font-size: 14px;
}

.project-links {
  display: flex;
  align-items: center;
  gap: 10px;
}

.project-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  color: #ea580c;
  background: rgba(255, 237, 213, 0.9);
  border: 1px solid rgba(249, 115, 22, 0.3);
  padding: 6px 10px;
  border-radius: 999px;
  transition: all 0.2s ease;

  &:hover {
    color: #c2410c;
    background: rgba(254, 215, 170, 0.95);
    border-color: rgba(234, 88, 12, 0.45);
  }
}

@media (max-width: 767px) {
  .project-grid {
    grid-template-columns: 1fr;
  }

  .project-showcase-header {
    padding: 16px;

    h2 {
      font-size: 20px;
    }
  }
}

// =============================================================
// 手动深色/亮色切换
// =============================================================
html.dark-mode {
  color-scheme: dark;

  --body-bg-color: $body-bg-color-dark;
  --content-bg-color: $content-bg-color-dark;
  --card-bg-color: $card-bg-color-dark;
  --text-color: $text-color-dark;
  --selection-bg: $selection-bg-dark;
  --selection-color: $selection-color-dark;
  --blockquote-color: $blockquote-color-dark;
  --link-color: $link-color-dark;
  --link-hover-color: $link-hover-color-dark;
  --brand-color: $brand-color-dark;
  --brand-hover-color: $brand-hover-color-dark;
  --table-row-odd-bg-color: $table-row-odd-bg-color-dark;
  --table-row-hover-bg-color: $table-row-hover-bg-color-dark;
  --menu-item-bg-color: $menu-item-bg-color-dark;
  --theme-color: $theme-color-dark;

  --btn-default-bg: $btn-default-bg-dark;
  --btn-default-color: $btn-default-color-dark;
  --btn-default-border-color: $btn-default-border-color-dark;
  --btn-default-hover-bg: $btn-default-hover-bg-dark;
  --btn-default-hover-color: $btn-default-hover-color-dark;
  --btn-default-hover-border-color: $btn-default-hover-border-color-dark;

  --highlight-background: $highlight-background-dark;
  --highlight-foreground: $highlight-foreground-dark;
  --highlight-gutter-background: $highlight-gutter-background-dark;
  --highlight-gutter-foreground: $highlight-gutter-foreground-dark;

  img {
    opacity: .75;

    &:hover {
      opacity: .9;
    }
  }

  iframe {
    color-scheme: light;
  }
}

// 右下角主题切换按钮
.theme-toggle {
  position: fixed;
  right: 20px;
  bottom: 90px;
  z-index: 9999;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--content-bg-color);
  color: var(--text-color);
  box-shadow: 0 2px 8px rgba(0, 0, 0, .15);
  cursor: pointer;
  font-size: 18px;
  line-height: 44px;
  text-align: center;
  transition: transform .2s ease, box-shadow .2s ease;

  &:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .2);
  }

  &:focus {
    outline: none;
  }
}

// =============================================================
// 碎碎念 / Memos 页面
// =============================================================
.memos-container {
  max-width: 720px;
  margin: 0 auto;
  padding: 20px 0;
}

.memos-content {
  min-height: 200px;
}

.memos-loading {
  text-align: center;
  color: var(--text-color);
  opacity: .6;
  padding: 40px 0;
}

.memos-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.memo-item {
  background: var(--content-bg-color);
  border: 1px solid rgba(128, 128, 128, .22);
  border-radius: 12px;
  padding: 18px 20px;
  transition: transform .2s ease, box-shadow .2s ease;

  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
  }
}

.memo-time {
  display: inline-block;
  padding: 2px 12px;
  margin-bottom: 10px;
  font-size: 12.5px;
  line-height: 1.7;
  border-radius: 999px;
  background: rgba(128, 128, 128, .12);
  color: var(--text-color);
  opacity: .75;
}

.memo-content {
  font-size: 15.5px;
  line-height: 1.9;
  color: var(--text-color);
  word-break: break-word;

  p {
    margin: 0 0 12px;

    &:last-child {
      margin-bottom: 0;
    }
  }

  blockquote {
    margin: 12px 0;
    padding: 4px 14px;
    border-left: 3px solid rgba(128, 128, 128, .4);
    color: var(--text-color);
    opacity: .85;
  }

  pre {
    margin: 12px 0;
    padding: 12px 14px;
    border-radius: 8px;
    background: rgba(128, 128, 128, .1);
    overflow-x: auto;

    code {
      background: none;
      padding: 0;
    }
  }

  code {
    padding: 2px 5px;
    border-radius: 4px;
    background: rgba(128, 128, 128, .15);
    font-size: .9em;
  }

  a {
    color: var(--link-color);
    word-break: break-all;

    &:hover {
      color: var(--link-hover-color);
    }
  }
}

.memo-image {
  max-width: 100%;
  border-radius: 8px;
  margin: 10px 0;
}

.memo-tag {
  display: inline-block;
  margin: 6px 6px 0 0;
  padding: 1px 10px;
  font-size: 12px;
  border-radius: 999px;
  background: rgba(128, 128, 128, .14);
  color: var(--text-color);
  opacity: .8;
}

.memos-footer {
  margin-top: 24px;
  text-align: center;
}

.memos-hint {
  margin-top: 10px;
  font-size: 13px;
  color: var(--text-color);
  opacity: .55;
}

.memo-button {
  padding: 6px 22px;
  border: 1px solid var(--btn-default-border-color);
  border-radius: 999px;
  background: var(--btn-default-bg);
  color: var(--btn-default-color);
  font-size: 14px;
  cursor: pointer;
  transition: background .2s ease, color .2s ease;

  &:hover {
    background: var(--btn-default-hover-bg);
    color: var(--btn-default-hover-color);
    border-color: var(--btn-default-hover-border-color);
  }
}

.memos-error {
  text-align: center;
  padding: 40px 20px;
  color: var(--text-color);

  h3 {
    margin-bottom: 10px;
  }

  pre {
    margin-top: 14px;
    padding: 10px;
    border-radius: 6px;
    background: rgba(128, 128, 128, .1);
    font-size: 13px;
    text-align: left;
    overflow-x: auto;
  }
}
