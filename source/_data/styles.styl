// ============================================
// 顶部导航栏/Header样式 - 蓝色渐变效果
// ============================================

// 顶部header区域（站点标题和导航）
.header,
.site-header,
.header-inner,
.site-nav {
  // 淡雅灰色渐变背景
  background: linear-gradient(135deg, #f7f7f7 0%, #f4f4f4 25%, #f2f2f2 50%, #f4f4f4 75%, #f7f7f7 100%);
  border-bottom: 1px solid rgba(220, 220, 220, 0.7);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

// 深色模式顶部header区域
@media (prefers-color-scheme: dark) {
  .header,
  .site-header,
  .header-inner,
  .site-nav {
    background: linear-gradient(135deg, #2f2f2f 0%, #2c2c2c 25%, #292929 50%, #2c2c2c 75%, #2f2f2f 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }
}

// NexT darkmode 类适配 - 顶部header区域
body.darkmode .header,
body.darkmode .site-header,
body.darkmode .header-inner,
body.darkmode .site-nav {
  background: linear-gradient(135deg, #2f2f2f 0%, #2c2c2c 25%, #292929 50%, #2c2c2c 75%, #2f2f2f 100%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
}
