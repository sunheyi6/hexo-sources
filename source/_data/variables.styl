// ============================================
// 主题变量配置 - 设计感黑白风格
// 参考: https://blog.zhheo.com/
// ============================================

// --------------------------------------------------
// 圆角变量 - 更圆润的设计
// --------------------------------------------------
$border-radius-inner = 12px
$border-radius       = 16px
$radius-sm           = 6px
$radius-md           = 10px
$radius-lg           = 16px
$radius-xl           = 20px
$radius-full         = 50%

// --------------------------------------------------
// 色彩系统 - 设计感黑白色系（暖调）
// --------------------------------------------------

// 主色调 - 温暖的深灰（不是纯黑）
$theme-color         = #3d3d3d
$theme-color-dark    = #5a5a5a

// 背景色 - 温暖的米白/象牙白
$body-bg-color       = #faf9f7
$body-bg-color-dark  = #1a1a1a
$content-bg-color    = #ffffff
$content-bg-color-dark = #242424

// 卡片背景
$card-bg-color       = #ffffff
$card-bg-color-dark  = #2d2d2d

// 文字颜色 - 温暖的深灰色系
$text-color          = #3d3d3d
$text-color-dark     = #e8e6e3
$black-light         = #5a5a5a
$black-dim           = #2d2d2d
$black-deep          = #1a1a1a

// 灰色系 - 暖调灰色
$whitesmoke          = #f5f4f2
$gainsboro           = #ebeae8
$grey-lighter        = #dddcd9
$grey-light          = #c5c4c1
$grey                = #9e9d9a
$grey-dark           = #7a7976
$grey-dim            = #5a5956

// 链接颜色 - 深灰暖调
$link-color          = #5a5a5a
$link-color-dark     = #b8b6b3
$link-hover-color    = #3d3d3d
$link-hover-color-dark = #e8e6e3
$link-decoration-color = #c5c4c1

// 边框颜色
$border-color        = #e8e6e3

// 引用块颜色
$blockquote-color    = #7a7976
$blockquote-color-dark = #9e9d9a

// 选中颜色 - 温暖的深灰
$selection-bg        = #5a5a5a
$selection-color     = #faf9f7
$selection-bg-dark   = #7a7976
$selection-color-dark = #1a1a1a

// 菜单项背景
$menu-item-bg-color  = #f5f4f2
$menu-item-bg-color-dark = #3d3d3d

// --------------------------------------------------
// 按钮样式 - 圆润按钮（设计感黑白）
// --------------------------------------------------
$btn-default-radius  = 24px
$btn-default-bg      = #3d3d3d
$btn-default-color   = #ffffff
$btn-default-border-color = transparent
$btn-default-hover-bg = #2d2d2d
$btn-default-hover-color = #ffffff
$btn-default-hover-border-color = transparent

// --------------------------------------------------
// 渐变色变量 - 黑白灰渐变
// --------------------------------------------------
$gradient-primary    = linear-gradient(135deg, #3d3d3d 0%, #5a5a5a 100%)
$gradient-secondary  = linear-gradient(135deg, #f5f4f2 0%, #ebeae8 100%)
$gradient-accent     = linear-gradient(135deg, #5a5a5a 0%, #7a7976 100%)

// --------------------------------------------------
// 阴影效果 - 柔和的阴影
// --------------------------------------------------
$box-shadow          = 0 2px 12px rgba(0, 0, 0, 0.04)
$box-shadow-hover    = 0 4px 20px rgba(0, 0, 0, 0.08)
$box-shadow-inner    = 0 2px 8px rgba(0, 0, 0, 0.03)

// --------------------------------------------------
// Note 标签圆角
// --------------------------------------------------
$note-border-radius  = 12px

// --------------------------------------------------
// Badge 圆角
// --------------------------------------------------
$badge-border-radius = 12px

// --------------------------------------------------
// 表格样式
// --------------------------------------------------
$table-row-odd-bg-color = #faf9f7
$table-row-hover-bg-color = #f5f4f2
$table-border-color = #e8e6e3

// --------------------------------------------------
// 代码块样式
// --------------------------------------------------
$highlight-background = #f8f8f7
$highlight-foreground = #3d3d3d
